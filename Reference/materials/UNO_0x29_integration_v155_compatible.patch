# UNO Pro Advanced — SysEx 0x29 hardware sequence read integration
# Target: v1.55-style architecture. Read-only; STORE/0x28 untouched.

--- a/protocol_map.py
+++ b/protocol_map.py
@@
 PRESET_NAME_READ_PREFIX = bytes([0xF0,0x00,0x21,0x1A,0x02,0x03,0x24,0x01])
+PRESET_PAGE_READ_PREFIX = bytes([0xF0,0x00,0x21,0x1A,0x02,0x03,0x29,0x00,0x00])
@@
 def preset_name_read(slot):
     n=max(1,min(256,int(slot)))-1
     return PRESET_NAME_READ_PREFIX+bytes([n//128,n%128,0xF7])
+def preset_page_read(page):
+    page=max(0,min(4,int(page)))
+    return PRESET_PAGE_READ_PREFIX+bytes([page,0xF7])
@@
